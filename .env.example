# Supabase 프로젝트 설정 > API에서 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# 서버 전용 키입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 아래 값은 각각 openssl rand -base64 48 명령으로 생성하세요.
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-characters
PASSWORD_PEPPER=replace-with-at-least-16-random-characters

SESSION_COOKIE_NAME=pc_session
SESSION_TTL_HOURS=168

# 초기 관리자 생성 스크립트에서만 사용합니다.
INITIAL_ADMIN_LOGIN_ID=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=관리자
INITIAL_ADMIN_POSITION=팀장
INITIAL_ADMIN_DEPARTMENT=웹팀
INITIAL_ADMIN_PHONE=010-0000-0000
